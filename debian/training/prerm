#!/bin/sh
set -eu
case "${1:-}" in
  remove|deconfigure)
    if [ -f /etc/treeseed-ai/platform.json ] && systemctl is-active --quiet treeseed-ai-manager-supervisor.service 2>/dev/null && grep -Eq '"training"' /etc/treeseed-ai/platform.json; then
      echo 'The manager desired state still enables training; run sudo treeai platform components disable training first.' >&2
      exit 1
    fi
    if systemctl is-enabled --quiet treeseed-ai-factory.service 2>/dev/null || systemctl is-active --quiet treeseed-ai-factory.service 2>/dev/null; then
      echo 'Disable factory mode before removing training.' >&2
      exit 1
    fi
    systemctl disable --now treeseed-ai-training.service 2>/dev/null || true
    ;;
esac
exit 0

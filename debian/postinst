#!/bin/sh
set -eu
if ! getent group treeseed-ai >/dev/null; then groupadd --system treeseed-ai; fi
if ! getent passwd treeseed-ai >/dev/null; then useradd --system --gid treeseed-ai --home-dir /var/lib/treeseed-ai --shell /usr/sbin/nologin treeseed-ai; fi
install -d -o treeseed-ai -g treeseed-ai -m 0750 /var/lib/treeseed-ai /var/cache/treeseed-ai /run/treeseed-ai
install -d -o root -g treeseed-ai -m 0750 /etc/treeseed/ai /etc/treeseed/ai/providers /etc/treeseed/ai/secrets.d
if [ ! -s /etc/treeseed/ai/secrets.d/inference-token ]; then
	umask 0027
	dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64 > /etc/treeseed/ai/secrets.d/inference-token
fi
chown root:treeseed-ai /etc/treeseed/ai/secrets.d/inference-token
chmod 0640 /etc/treeseed/ai/secrets.d/inference-token
systemctl daemon-reload
systemctl enable --now treeseed-ai.service

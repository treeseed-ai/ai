TRAINING_API_IMAGE=example/training-api@sha256:replace-with-release-digest
TRAINING_MANAGER_IMAGE=example/training-manager@sha256:replace-with-release-digest
MARKER_WORKER_IMAGE=example/marker-worker@sha256:replace-with-release-digest
AXOLOTL_WORKER_IMAGE=example/axolotl-worker@sha256:replace-with-release-digest
ARTIFACT_WORKER_IMAGE=example/artifact-worker@sha256:replace-with-release-digest
TRAINING_MIGRATIONS_IMAGE=example/training-migrations@sha256:replace-with-release-digest
DATABASE_URL=postgresql://training:change-me@database.example/training
AI_API_KEYS=[]
S3_ENDPOINT=https://objects.example
S3_BUCKET=ai-training
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
SIGNING_KEY_ID=training-production-1
SIGNING_KEY_FILE=/etc/treeseed-ai/training/secrets/artifact-signing-key.pem
DOCUMENT_INPUTS=/var/lib/treeseed-ai/training/inputs
CONTROL_BIND=127.0.0.1

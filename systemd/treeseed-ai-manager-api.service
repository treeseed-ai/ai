[Unit]
Description=TreeAI platform management API
After=treeseed-ai-manager-supervisor.service network-online.target
Requires=treeseed-ai-manager-supervisor.service

[Service]
Type=simple
User=treeseed-ai-manager
Group=treeseed-ai-manager
ExecStart=/usr/lib/treeseed-ai/runtime/bin/node /usr/lib/treeseed-ai/manager/dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/treeseed-ai/manager /run/treeseed-ai/manager

[Install]
WantedBy=multi-user.target

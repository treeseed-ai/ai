[Unit]
Description=TreeSeed AI appliance supervisor
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=treeseed-ai
Group=treeseed-ai
SupplementaryGroups=docker
Environment=TREESEED_AI_APPLIANCE_MANIFEST=/etc/treeseed/ai/treeseed.ai-appliance.yaml
Environment=TREESEED_AI_ROOT=/var/lib/treeseed-ai
Environment=TREESEED_AI_PACKAGE_ROOT=/usr/lib/treeseed-ai
Environment=TREESEED_AI_MODEL_CACHE=/var/cache/treeseed-ai/models
ExecStart=/usr/bin/node /usr/lib/treeseed-ai/dist/cli/main.js supervise
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/treeseed-ai /var/cache/treeseed-ai /run/treeseed-ai

[Install]
WantedBy=multi-user.target

[Unit]
Description=Converge TreeAI desired platform state
After=treeseed-ai-manager-supervisor.service docker.service
Requires=treeseed-ai-manager-supervisor.service

[Service]
Type=oneshot
ExecStart=/usr/lib/treeseed-ai/runtime/bin/node /usr/lib/treeseed-ai/manager/dist/converge.js
TimeoutStartSec=1h

{
  "$schema": "https://opencode.ai/config.json",
  "model": "treeseed/treeseed-qwen3.5-4b",
  "provider": {
    "treeseed": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TreeSeed AI",
      "options": {
        "baseURL": "http://host.docker.internal:4771/v1",
        "apiKey": "{env:TREESEED_AI_GATEWAY_TOKEN}"
      },
      "models": {
        "treeseed-qwen3.5-4b": {
          "name": "TreeSeed Qwen3.5 4B",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
